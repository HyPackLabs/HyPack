# Clerk — https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/modpacks
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/modpacks
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/modpacks
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/modpacks

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CurseForge — https://console.curseforge.com/
# Paste your full key on one line (HyPack reads this without $ expansion).
CURSEFORGE_API_KEY=

# Optional: Clerk user id for homepage featured modpacks (defaults to username "hypack")
# HYPACK_FEATURED_CLERK_USER_ID=

# Optional: seconds to cache homepage "Mods listed" count (default 21600 = 6 hours)
# HYTALE_MOD_COUNT_CACHE_SECONDS=21600
